<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.codedogapp</groupId>
    <artifactId>gridlink</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>GridLink</name>
    <description>AG Grid server-side model compatibility layer</description>
    <url>https://github.com/codedogapp/gridlink</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Bakhomious Basta</name>
            <email>bakhomioussvp@gmail.com</email>
            <organization>CodeDog</organization>
            <organizationUrl>https://github.com/codedogapp</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/codedogapp/gridlink.git</connection>
        <developerConnection>scm:git:ssh://github.com:codedogapp/gridlink.git</developerConnection>
        <url>https://github.com/codedogapp/gridlink/tree/main</url>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-data-elasticsearch.version>6.1.0</spring-data-elasticsearch.version>
        <jspecify.version>1.0.1</jspecify.version>
        <junit.version>5.11.4</junit.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <jreleaser-maven-plugin.version>1.25.0</jreleaser-maven-plugin.version>
    </properties>

    <modules>
        <module>gridlink-core</module>
        <module>gridlink-elasticsearch</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.codedogapp</groupId>
                <artifactId>gridlink-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.data</groupId>
                <artifactId>spring-data-elasticsearch</artifactId>
                <version>${spring-data-elasticsearch.version}</version>
            </dependency>

            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Stage artifacts (main + sources + javadoc jars, unsigned) into a single
             root-level directory that JReleaser later signs and deploys to Central.
             Invoke with:  mvn -Ppublication clean deploy  -->
        <profile>
            <id>publication</id>
            <properties>
                <!-- Every reactor module deploys into the SAME root directory so
                     JReleaser can collect them from one staging repository. -->
                <altDeploymentRepository>local::file:${session.executionRootDirectory}/target/staging-deploy</altDeploymentRepository>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <source>${maven.compiler.release}</source>
                            <notimestamp>true</notimestamp>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <failOnError>false</failOnError>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Sign, deploy to Maven Central, and cut the GitHub release + changelog.
             Runs once at the aggregator (inherited=false). Invoke with:
               mvn -N -Pjreleaser jreleaser:full-release
             Credentials are read from JRELEASER_* environment variables. -->
        <profile>
            <id>jreleaser</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jreleaser-maven-plugin</artifactId>
                        <version>${jreleaser-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <jreleaser>
                                <signing>
                                    <active>ALWAYS</active>
                                    <pgp>
                                        <active>ALWAYS</active>
                                        <armored>true</armored>
                                    </pgp>
                                </signing>
                                <deploy>
                                    <maven>
                                        <mavenCentral>
                                            <sonatype>
                                                <active>RELEASE</active>
                                                <url>https://central.sonatype.com/api/v1/publisher</url>
                                                <stagingRepositories>target/staging-deploy</stagingRepositories>
                                                <!-- Verify POMs, sign artifacts, assert sources+javadoc jars are staged. -->
                                                <applyMavenCentralRules>true</applyMavenCentralRules>
                                            </sonatype>
                                        </mavenCentral>
                                    </maven>
                                </deploy>
                                <release>
                                    <github>
                                        <owner>codedogapp</owner>
                                        <name>gridlink</name>
                                        <!-- You push the tag (after merging the prepare-release PR);
                                             JReleaser only cuts the release for the existing tag. -->
                                        <skipTag>true</skipTag>
                                        <changelog>
                                            <formatted>ALWAYS</formatted>
                                            <preset>conventional-commits</preset>
                                            <contributors>
                                                <format>- {{contributorName}}{{#contributorUsernameAsLink}} ({{.}}){{/contributorUsernameAsLink}}</format>
                                            </contributors>
                                        </changelog>
                                    </github>
                                </release>
                            </jreleaser>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>