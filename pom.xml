<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.codedogapp</groupId>
    <artifactId>gridlink</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>

    <name>GridLink</name>
    <description>AG Grid server side model compatability layer</description>
    <url>https://github.com/codedogapp/gridlink</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Bakhomious Basta</name>
            <email>bakhomioussvp@gmail.com</email>
            <organization>CodeDog</organization>
            <organizationUrl>https://github.com/codedogapp</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/codedogapp/gridlink.git</connection>
        <developerConnection>scm:git:ssh://github.com:codedogapp/gridlink.git</developerConnection>
        <url>https://github.com/codedogapp/gridlink/tree/main</url>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-data-elasticsearch.version>6.1.0</spring-data-elasticsearch.version>
        <jspecify.version>1.0.1</jspecify.version>
        <junit.version>5.11.4</junit.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    </properties>

    <modules>
        <module>gridlink-core</module>
        <module>gridlink-elasticsearch</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.codedogapp</groupId>
                <artifactId>gridlink-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.data</groupId>
                <artifactId>spring-data-elasticsearch</artifactId>
                <version>${spring-data-elasticsearch.version}</version>
            </dependency>

            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>docs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <source>${maven.compiler.release}</source>
                            <doctitle>GridLink ${project.version} API</doctitle>
                            <windowtitle>GridLink ${project.version} API</windowtitle>
                            <notimestamp>true</notimestamp>
                            <detectLinks>false</detectLinks>
                            <detectOfflineLinks>false</detectOfflineLinks>
                            <failOnError>false</failOnError>
                            <bottom>
                                <![CDATA[<a href="https://github.com/codedogapp/gridlink">GridLink</a> &middot; MIT License &middot; <a href="https://github.com/codedogapp/gridlink#readme">Guide</a>]]></bottom>
                            <links>
                                <link>https://docs.oracle.com/en/java/javase/17/docs/api/</link>
                                <link>https://docs.spring.io/spring-data/elasticsearch/docs/current/api/</link>
                            </links>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>